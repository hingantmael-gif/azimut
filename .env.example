# Auth Mova (ne pas committer les secrets)
# Local : API sur la machine
EXPO_PUBLIC_API_URL=http://localhost:8787
# Prod : forcé par scripts/deploy-install-site.mjs →
#   https://mova-api.onrender.com

# Google OAuth — client ID type « Application Web » (Google Cloud Console)
# 1) console.cloud.google.com → APIs & Services → Credentials → Create OAuth client ID → Web
# 2) Origins JS autorisées : https://mova.app  (+ http://localhost:8082 en local)
# 3) URI de redirection : https://mova.app  et https://mova.app/
#    (racine uniquement — ne pas mettre /welcome, sinon Google bloque « demande non valide »)
#    (+ exp:// / mova://oauth pour natif si besoin)
# 4) Coller le client ID ici, rebuild / redeploy
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Adresse publique du site et compte propriétaire (facultatif)
# EXPO_PUBLIC_SITE_URL=https://mova.app
# EXPO_PUBLIC_OWNER_EMAIL=
# Optionnel natif :
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# Intégrations OAuth (client ID publics — secrets côté backend/.env)
EXPO_PUBLIC_GARMIN_CLIENT_ID=
EXPO_PUBLIC_STRAVA_CLIENT_ID=

# Billing — RevenueCat (Google Play / App Store). Requis pour build EAS natif.
# Produits Play/App Store à créer : mova_premium_monthly + mova_premium_annual (voir src/premium/quotas.ts)
# Entitlement RevenueCat : premium
# EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
# EXPO_PUBLIC_REVENUECAT_IOS_KEY=
# Backend : REVENUECAT_WEBHOOK_SECRET= (Bearer pour POST /billing/webhook/revenuecat)

# Liens vers les fiches store — vides tant que l'app n'est pas publiée (voir docs/PLAY_STORE.md).
# Une fois en ligne : colle le lien, redéploie le site → le bouton « Obtenir sur Google Play »/App Store apparaît
# automatiquement sur /install et /telecharger.html (sinon elles affichent « Bientôt disponible »).
# EXPO_PUBLIC_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=app.mova.coach
# EXPO_PUBLIC_APP_STORE_URL=
