# Auth Azimut (ne pas committer les secrets)
EXPO_PUBLIC_API_URL=http://localhost:8787

# Google OAuth — client ID type « Application Web » (Google Cloud Console)
# 1) console.cloud.google.com → APIs & Services → Credentials → Create OAuth client ID → Web
# 2) Origins JS autorisées : https://hingantmael-gif.github.io  (+ http://localhost:8082 en local)
# 3) URI de redirection : https://hingantmael-gif.github.io  et https://hingantmael-gif.github.io/
#    (+ exp:// / azimut://oauth pour natif si besoin)
# 4) Coller le client ID ici, rebuild / redeploy
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Optionnel natif :
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# Intégrations OAuth (client ID publics — secrets côté backend/.env)
EXPO_PUBLIC_GARMIN_CLIENT_ID=
EXPO_PUBLIC_STRAVA_CLIENT_ID=
