{
  "expo": {
    "name": "Mova",
    "slug": "mova",
    "description": "Coach sportif personnel : programme multi-mois, tracker GPS, séance adaptée à ton sommeil et à ta forme.",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#07111F",
      "dark": {
        "image": "./assets/splash-icon.png",
        "backgroundColor": "#07111F"
      }
    },
    "userInterfaceStyle": "automatic",
    "scheme": "mova",
    "newArchEnabled": true,
    "android": {
      "package": "app.mova.coach",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#07111F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "POST_NOTIFICATIONS"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "mova",
              "host": "*"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "SEND",
          "category": [
            "DEFAULT"
          ],
          "data": [
            {
              "mimeType": "text/plain"
            },
            {
              "mimeType": "application/gpx+xml"
            },
            {
              "mimeType": "application/vnd.garmin.tcx+xml"
            }
          ]
        },
        {
          "action": "SEND_MULTIPLE",
          "category": [
            "DEFAULT"
          ],
          "data": [
            {
              "mimeType": "text/plain"
            },
            {
              "mimeType": "*/*"
            }
          ]
        }
      ]
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.mova.coach",
      "buildNumber": "1",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Mova utilise ta position pour guider ta séance (distance, allure, carte).",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Mova continue de suivre ta séance (distance, allure, tracé) quand l’écran est verrouillé. La position n’est utilisée que pendant un enregistrement.",
        "LSApplicationQueriesSchemes": [
          "strava",
          "connect"
        ],
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "Workout",
            "LSItemContentTypes": [
              "public.plain-text",
              "com.topografixix.gpx",
              "public.xml"
            ]
          }
        ],
        "UIBackgroundModes": [
          "location"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "static",
      "name": "Mova",
      "shortName": "Mova",
      "description": "Coaching multi-sport — installe Mova sur téléphone, tablette ou PC.",
      "themeColor": "#07111F",
      "backgroundColor": "#07111F"
    },
    "plugins": [
      [
        "expo-router",
        {
          "asyncRoutes": {
            "web": "production"
          }
        }
      ],
      "expo-secure-store",
      "expo-document-picker",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Mova utilise ta position pour guider ta séance (distance, allure, carte).",
          "locationAlwaysAndWhenInUsePermission": "Mova continue de suivre ta séance quand l’écran est verrouillé. La position n’est utilisée que pendant un enregistrement.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#0E8F6F",
          "defaultChannel": "training",
          "sounds": []
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Autorise l’accès à tes photos pour définir ta photo de profil.",
          "cameraPermission": "Autorise l’accès à la caméra pour prendre ta photo de profil.",
          "microphonePermission": false
        }
      ],
      "expo-web-browser",
      "expo-sqlite",
      "expo-font",
      "expo-task-manager",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
