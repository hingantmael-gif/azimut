# API Azimut — auth
PORT=8787
JWT_SECRET=change-me
# Envoi code 6 chiffres (choisir un) :
RESEND_API_KEY=
# BREVO_API_KEY=
EMAIL_FROM=Azimut <onboarding@resend.dev>
# Dev only : renvoyer demoCode si pas de mail
AUTH_ALLOW_DEMO_CODE=true
# Garmin Connect OAuth (programme développeur Garmin — PKCE)
GARMIN_CLIENT_ID=
GARMIN_CLIENT_SECRET=
# Strava OAuth
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_VERIFY_TOKEN=training-demo

# ——— Stripe (abonnement Premium sur le web) ———
# Clés : https://dashboard.stripe.com/test/apikeys  (mode test d'abord, sk_test_… ; puis sk_live_… en production)
STRIPE_SECRET_KEY=
# Secret de signature du webhook (Developers → Webhooks → ton endpoint → "Signing secret", whsec_…)
STRIPE_WEBHOOK_SECRET=
# Identifiants des prix créés dans Product catalog (price_…)
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_ANNUAL=
# Adresse de l'app (retour après paiement)
APP_URL=https://hingantmael-gif.github.io
# Jours d'essai gratuit (7 par défaut, 0 = aucun)
STRIPE_TRIAL_DAYS=7
# À passer à false dès que les webhooks Stripe / RevenueCat fonctionnent : le client ne peut plus s'auto-attribuer le Premium
BILLING_TRUST_CLIENT=true
